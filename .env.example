# Copy to .env and fill in locally. Never commit .env.
# Frontend server-side proxy target (optional; default http://127.0.0.1:8000). No secrets.
# BACKEND_BASE_URL=http://127.0.0.1:8000

# Deepfire (Norrsken wildfire signal). Backend only; never expose to the browser.
DEEPFIRE_CLIENT_ID=
DEEPFIRE_CLIENT_SECRET=
